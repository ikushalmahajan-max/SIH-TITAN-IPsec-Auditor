# ==========================================
# SIH IPsec Analyzer - Environment Configuration
# ==========================================

# Server Configuration
FLASK_ENV=production
FLASK_DEBUG=false
PORT=5000
HOST=0.0.0.0

# CORS Configuration (Allowed frontend origin or * for public API)
CORS_ORIGINS=*

# Live Packet Capture Setting
# In cloud deployments (Render, Vercel, Railway, etc.), keep false.
# Only enable in local dedicated monitoring environments with packet capture permissions.
LIVE_CAPTURE_ENABLED=false
SNIFF_INTERFACE=

# File Upload Limit (bytes - 500MB)
MAX_CONTENT_LENGTH=524288000
